# ClauseCheck environment. Copy to .env (gitignored) and fill in the values.
# Never commit real keys. scripts/start.sh loads .env if it exists.
# Keep comments on their own lines: Docker --env-file and `fly secrets import`
# treat a trailing "# ..." as part of the value.

# --- LLM (required) ---
OPENAI_API_KEY=
# Required, no default; the app refuses to start without it.
# gpt-6-luna for local experiments, gpt-6.1-terra for production.
CLAUSECHECK_MODEL=
# Reasoning effort: none, low, medium or high.
CLAUSECHECK_REASONING_EFFORT=low

# --- Server (optional) ---
# Port used by scripts/start.sh.
PORT=8000

# --- Logging (optional) ---
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# json (default, for Fly.io) or console (readable, for local dev).
LOG_FORMAT=json

# --- LangSmith tracing (optional; metadata only) ---
# Set to true to send traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ClauseCheck
# Both must be true when tracing is on: never send clause text or model replies.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
